"""stol tui - interactive browser for stol worktrees.

Prints the selected directory on stdout (nothing on quit), so the intended
usage is from a shell function:

    cd "$(stol tui)"

Keys:
    up/down     move selection
    enter       exit and print the selected path (cd via the stui wrapper,
                like `a2 pick`); `s` spawns $SHELL in the worktree instead
    s           spawn $SHELL in the selected worktree
    n           create a new worktree in the selected project
    e           check out an existing branch in a new worktree
    d           delete the selected worktree (uses `stol rm`, runs hooks)
    y           sync the selected project (`stol sync`)
    t           toggle sort by name / modification time
    /           filter entries
    space       collapse/expand a project
    tab         toggle the detail pane
    r           refresh
    ?           help
    q / esc     quit
"""

import curses
import os
import subprocess
import sys
import textwrap
import threading
import time
from concurrent.futures import ThreadPoolExecutor

STOL_ROOT = os.environ.get("STOL_ROOT", "/mnt/work")
PROJECTS_DIR = os.path.join(STOL_ROOT, "projects")

GIT_TIMEOUT = 15


def fuzzy_score(query, s):
    """fzf-lite subsequence match. Returns a score (higher is better) or None."""
    q, t = query.lower(), s.lower()
    pos, score, last, first = 0, 0, -2, None
    for ch in q:
        idx = t.find(ch, pos)
        if idx < 0:
            return None
        if first is None:
            first = idx
        if idx == last + 1:
            score += 2          # consecutive run bonus
        if idx == 0 or t[idx - 1] in "/-_ .":
            score += 2          # word boundary bonus
        score += 1
        last, pos = idx, idx + 1
    return score * 2 - (last - first + 1)   # prefer compact spans


class Entry:
    """A row in the list: either a project or a worktree directory."""

    def __init__(self, kind, project, path, name, mtime):
        self.kind = kind          # "project" | "worktree" | "template"
        self.project = project    # project name (worktree/template only)
        self.path = path
        self.name = name
        self.mtime = mtime
        self.branch = ""
        self.dirty = 0
        self.ahead = 0            # commits ahead of upstream

    def display(self):
        return self.name


def run_git(path, args, timeout=GIT_TIMEOUT):
    """Run git in path, returning stripped stdout or ""."""
    try:
        out = subprocess.run(
            ["git", "-C", path, *args],
            capture_output=True, text=True, timeout=timeout,
        )
        return out.stdout.strip() if out.returncode == 0 else ""
    except Exception:
        return ""


def dir_mtime(path):
    try:
        return os.stat(path).st_mtime
    except OSError:
        return 0.0


def fmt_ago(ts):
    s = int(time.time() - ts)
    if s < 0:
        return "now"
    for unit, div in (("d", 86400), ("h", 3600), ("m", 60)):
        if s >= div:
            return f"{s // div}{unit}"
    return f"{s}s"


def inspect_worktree(path, name, project):
    """Populate git info for a single worktree directory."""
    e = Entry("template" if name.startswith("00-") else "worktree",
              project, path, name, dir_mtime(path))
    e.branch = run_git(path, ["branch", "--show-current"], timeout=10)
    out = run_git(path, ["status", "--porcelain"], timeout=60)
    if out:
        e.dirty = len(out.splitlines())
    out = run_git(path, ["rev-list", "--count", "@{upstream}..HEAD"], timeout=10)
    if out.isdigit():
        e.ahead = int(out)
    return e


def load_entries(sort_time=False):
    """Scan STOL_ROOT/projects and collect project + worktree entries."""
    entries = []
    if not os.path.isdir(PROJECTS_DIR):
        return entries
    projects = sorted(d for d in os.listdir(PROJECTS_DIR)
                      if os.path.isdir(os.path.join(PROJECTS_DIR, d)))

    def worktree_dirs(project):
        pdir = os.path.join(PROJECTS_DIR, project)
        wts = []
        for name in sorted(os.listdir(pdir)):
            path = os.path.join(pdir, name)
            if not os.path.isdir(path) or name in (".repo", ".stol"):
                continue
            wts.append((path, name))
        return wts

    with ThreadPoolExecutor(max_workers=8) as pool:
        futures = {
            project: [pool.submit(inspect_worktree, p, n, project)
                      for p, n in worktree_dirs(project)]
            for project in projects
        }
        for project in projects:
            pdir = os.path.join(PROJECTS_DIR, project)
            entries.append(Entry("project", project, pdir, project, dir_mtime(pdir)))
            wts = [f.result() for f in futures[project]]
            if sort_time:
                wts.sort(key=lambda e: e.mtime, reverse=True)
            entries.extend(wts)
    if sort_time:
        entries.sort(key=lambda e: (e.kind != "project", -e.mtime, e.project))
    return entries


# ---------------------------------------------------------------------------
# Detail pane: computed in the background for the selected entry.
# Each line is a (style, text) tuple where style is one of:
#   head  - section header (bold cyan)
#   val   - emphasized value (green)
#   warn  - problem indicator (red)
#   dim   - subdued metadata
#   norm  - plain text
# ---------------------------------------------------------------------------

def compute_detail(path, entry):
    """Gather git details for one worktree. Returns a list of (style, text)."""
    if entry.kind == "project":
        return compute_project_detail(path, entry)

    lines = []
    branch = entry.branch or "(detached)"

    # upstream tracking state
    upstream = run_git(path, ["rev-parse", "--abbrev-ref", "@{upstream}"], timeout=10)
    track = ""
    if upstream:
        counts = run_git(path, ["rev-list", "--left-right", "--count",
                                f"{upstream}...HEAD"], timeout=10)
        if "\t" in counts:
            behind, ahead = counts.split("\t")
            track = f" · {upstream}"
            if ahead != "0" or behind != "0":
                track += f" (↑{ahead} ↓{behind})"
    lines.append(("head", "Branch"))
    lines.append(("val", f"  {branch}{track}"))

    # last commit
    out = run_git(path, ["log", "-1", "--format=%h%n%an%n%ar%n%s"], timeout=10)
    if out:
        sha, author, when, subject = (out.splitlines() + [""] * 4)[:4]
        lines.append(("head", "Last commit"))
        lines.append(("val", f"  {sha}"))
        lines.append(("norm", f"  {subject}"))
        lines.append(("dim", f"  {author} · {when}"))

    # dirty files (porcelain status, truncated)
    out = run_git(path, ["status", "--porcelain"], timeout=60)
    if out:
        entries_ = out.splitlines()
        lines.append(("head", f"Status ({len(entries_)} dirty)"))
        for line in entries_[:20]:
            style = "warn" if line[:2].strip() in ("M", "D") else "norm"
            lines.append((style, "  " + line))
        if len(entries_) > 20:
            lines.append(("dim", f"  … and {len(entries_) - 20} more"))
    else:
        lines.append(("head", "Status"))
        lines.append(("val", "  clean"))

    # diffstat vs upstream
    if upstream:
        out = run_git(path, ["diff", "--stat", f"{upstream}...HEAD"], timeout=GIT_TIMEOUT)
        if out:
            summary = out.splitlines()[-1]
            lines.append(("head", f"Diff vs {upstream}"))
            lines.append(("norm", f"  {summary}"))

    # reflog for this worktree's HEAD
    out = run_git(path, ["reflog", "--date=relative", "-n", "12"], timeout=10)
    if out:
        lines.append(("head", "Reflog"))
        for line in out.splitlines()[:12]:
            lines.append(("norm", "  " + line))
    return lines


def compute_project_detail(path, entry):
    lines = [("head", "Project"), ("val", f"  {entry.name}")]
    lines.append(("dim", f"  {path}"))
    lines.append(("dim", f"  last used {fmt_ago(entry.mtime)} ago"))
    out = run_git(path, ["worktree", "list", "--porcelain"], timeout=10)
    if out:
        blocks = out.split("\n\n")
        n = sum(1 for b in blocks if b.strip() and "detached" not in b or b.strip())
        lines.append(("head", f"Worktrees ({max(0, len(blocks))})"))
        for b in blocks[:15]:
            first = b.splitlines()[0] if b.strip() else ""
            name = os.path.basename(first.replace("worktree ", "")) if first else ""
            br = next((l.replace("branch ", "") for l in b.splitlines()
                       if l.startswith("branch")), "detached")
            if name:
                lines.append(("norm", f"  {name}  [{br.replace('refs/heads/', '')}]"))
    return lines


class Tui:
    def __init__(self, screen):
        self.screen = screen
        self.entries = []
        self.collapsed = set()
        self.cur = 0
        self.top = 0
        self.sort_time = False
        self.filter = ""
        self.message = ""
        self.rows = []          # rows currently visible, in order
        self.show_pane = True

        # detail pane state
        self.detail_cache = {}  # path -> list of (style, text)
        self.detail_jobs = []   # (path, Thread) in flight

        curses.start_color()
        curses.use_default_colors()
        for i, (fg, bg) in enumerate([
            (-1, -1),                    # 1 normal
            (curses.COLOR_CYAN, -1),     # 2 project header
            (curses.COLOR_GREEN, -1),    # 3 selected
            (curses.COLOR_YELLOW, -1),   # 4 template
            (curses.COLOR_RED, -1),      # 5 dirty/warn
            (curses.COLOR_MAGENTA, -1),  # 6 branch
            (curses.COLOR_BLACK, -1),    # 7 dim
            (curses.COLOR_CYAN, -1),     # 8 pane header
        ]):
            curses.init_pair(i + 1, fg, bg)
        self.ATTR = {
            "norm": curses.color_pair(1),
            "head": curses.color_pair(8) | curses.A_BOLD,
            "val": curses.color_pair(3),
            "warn": curses.color_pair(5),
            # A_DIM is an intensity attribute, not a color, so subdued text
            # stays visible under any color scheme
            "dim": curses.color_pair(1) | curses.A_DIM,
        }
        self.refresh_data()

    # ----- data -----

    def refresh_data(self):
        self.entries = load_entries(self.sort_time)
        self.detail_cache = {}
        self.detail_jobs = []
        self.rebuild_rows()

    def rebuild_rows(self):
        """Flatten entries honoring collapsed projects and the filter.

        With an active filter, matching is fuzzy (subsequence) and rows are
        ranked best-match first while keeping project grouping."""
        f = self.filter.strip()
        rows = []
        if f:
            # score every worktree against name/branch/project
            children = {}       # project -> [(score, entry)]
            proj_best = {}      # project -> best child score
            for e in self.entries:
                if e.kind == "project":
                    continue
                best = max(
                    (s for s in (fuzzy_score(f, e.name), fuzzy_score(f, e.branch),
                                 fuzzy_score(f, e.project)) if s is not None),
                    default=None)
                if best is None:
                    continue
                children.setdefault(e.project, []).append((best, e))
                proj_best[e.project] = max(proj_best.get(e.project, -(1 << 30)), best)
            pentries = {e.name: e for e in self.entries if e.kind == "project"}
            for proj in sorted(children, key=lambda p: -proj_best[p]):
                if proj in pentries:
                    rows.append(pentries[proj])
                for _, e in sorted(children[proj], key=lambda t: -t[0]):
                    rows.append(e)
        else:
            for e in self.entries:
                if e.kind == "project":
                    rows.append(e)
                else:
                    if e.project in self.collapsed:
                        continue
                    rows.append(e)
        self.rows = rows
        if self.cur >= len(self.rows):
            self.cur = max(0, len(self.rows) - 1)

    def current(self):
        if 0 <= self.cur < len(self.rows):
            return self.rows[self.cur]
        return None

    # ----- detail pane -----

    def ensure_detail(self, entry):
        """Kick off background computation of the detail pane, if needed."""
        if entry.path in self.detail_cache:
            return
        if any(p == entry.path for p, _ in self.detail_jobs):
            return
        t = threading.Thread(target=self._detail_worker,
                             args=(entry.path, entry), daemon=True)
        self.detail_jobs.append((entry.path, t))
        t.start()

    def _detail_worker(self, path, entry):
        self.detail_cache[path] = compute_detail(path, entry)

    def reap_detail_jobs(self):
        """Drop finished jobs; True if anything completed since last call."""
        alive = [(p, t) for p, t in self.detail_jobs if t.is_alive()]
        done = len(alive) < len(self.detail_jobs)
        self.detail_jobs = alive
        return done

    # ----- actions -----

    def spawn_shell(self, path):
        shell = os.environ.get("SHELL", "/bin/bash")
        self.suspend()
        print(f"# subshell in {path} (exit to return to stol tui)")
        rc = subprocess.call([shell, "-i"], cwd=path)
        self.message = f"subshell exited with {rc}"
        self.detail_cache.pop(path, None)
        self.resume()

    def run_stol(self, args, cwd=None):
        """Run a stol command, showing output after it finishes."""
        self.suspend()
        cmd = ["stol", *args]
        print(f"$ {' '.join(cmd)}")
        try:
            rc = subprocess.call(cmd, cwd=cwd)
        except FileNotFoundError:
            rc = 1
            print("stol not found on PATH")
        print("-- press enter to continue --")
        input()
        self.message = f"{cmd[1]} {'ok' if rc == 0 else f'failed ({rc})'}"
        self.resume()
        self.refresh_data()

    def suspend(self):
        """Leave curses mode temporarily to interact with the terminal directly."""
        curses.def_prog_mode()
        curses.endwin()

    def resume(self):
        curses.reset_prog_mode()
        self.screen.refresh()
        self.draw()

    def confirm(self, question):
        return self.prompt(f"{question} (y/N) ", allow_empty=True).strip().lower() == "y"

    def prompt(self, label, allow_empty=False):
        """Read a line of input at the bottom of the screen."""
        height, width = self.screen.getmaxyx()
        self.screen.move(height - 1, 0)
        self.screen.clrtoeol()
        self.screen.addstr(height - 1, 0, label, curses.color_pair(1) | curses.A_BOLD)
        self.screen.refresh()
        curses.echo()
        try:
            text = self.screen.getstr(height - 1, len(label)).decode("utf-8", "replace")
        except Exception:
            text = ""
        curses.noecho()
        self.screen.move(height - 1, 0)
        self.screen.clrtoeol()
        if not text and not allow_empty:
            return None
        return text

    def filter_prompt(self):
        """Live fuzzy filter: the list updates as you type, fzf-style.

        Enter accepts the query, Esc clears it, Ctrl-U clears the line.
        The shortcut footer stays visible on the line above."""
        height, width = self.screen.getmaxyx()
        q = self.filter
        self.message = ""
        while True:
            self.filter = q
            self.rebuild_rows()
            self.cur = 0
            self.top = 0
            self.draw()
            prompt = f" / {q}█" if q else " / (fuzzy filter) █"
            try:
                self.screen.addstr(height - 1, 0, prompt[:width - 1],
                                   curses.color_pair(1) | curses.A_BOLD)
                self.screen.clrtoeol()
            except curses.error:
                pass
            self.screen.refresh()

            key = self.screen.getch()
            if key in (10, 13, curses.KEY_ENTER):
                self.filter = q
                break
            elif key == 27:  # esc clears the filter
                q = ""
                self.filter = ""
                self.rebuild_rows()
                self.cur = 0
                self.top = 0
                break
            elif key in (curses.KEY_BACKSPACE, 127, 8):
                q = q[:-1]
            elif key == 21:  # ctrl-u
                q = ""
            elif 32 <= key <= 126:
                q += chr(key)

    # ----- drawing -----

    def line_attrs(self, e, selected):
        if selected:
            return curses.color_pair(3) | curses.A_BOLD
        if e.kind == "project":
            return curses.color_pair(2) | curses.A_BOLD
        if e.kind == "template":
            return curses.color_pair(4)
        return curses.color_pair(1)

    def draw(self):
        self.screen.erase()
        height, width = self.screen.getmaxyx()

        pane = self.show_pane and width >= 100
        list_w = min(46, max(30, width // 3)) if pane else width

        # header
        header = f" stol tui  {STOL_ROOT}"
        if self.filter:
            header += f"   [filter: /{self.filter}]"
        header += f"   [sort: {'time' if self.sort_time else 'name'}]"
        self.screen.addstr(0, 0, header[:width - 1], curses.color_pair(1) | curses.A_DIM)

        # list pane
        avail = max(1, height - 4)
        if self.cur < self.top:
            self.top = self.cur
        if self.cur >= self.top + avail:
            self.top = self.cur - avail + 1
        view = self.rows[self.top:self.top + avail]

        lw = list_w - 1  # leave the separator column
        for i, e in enumerate(view):
            row = self.top + i
            selected = row == self.cur
            if e.kind == "project":
                arrow = "+" if e.name in self.collapsed else "-"
                left = f"{arrow} {e.name}/"
            else:
                marker = ""
                if e.dirty:
                    marker = f" [~{e.dirty}]"
                if e.ahead:
                    marker += f" [+{e.ahead}]"
                left = f"  {e.name}{marker}"
            right = e.branch if (e.kind != "project" and e.branch) else fmt_ago(e.mtime)
            pad = max(1, lw - len(left) - len(right))
            line = (left + " " * pad + right)[:lw]
            try:
                self.screen.addstr(row + 1, 0, line, self.line_attrs(e, selected))
            except curses.error:
                pass

        # detail pane, boxed with rounded corners like an fzf preview window
        if pane:
            cur = self.current()
            bx, bw = list_w, width - list_w      # box columns
            top, bot = 1, height - 3             # box rows
            # default foreground, normal intensity: visible under any scheme
            edge = curses.color_pair(1)
            try:
                title = f"─ {cur.name} " if cur else "─"
                fill = "─" * max(0, bw - len(title) - 2)
                self.screen.addstr(top, bx, f"╭{title}{fill}╮"[:bw], edge)
                for row in range(top + 1, bot):
                    self.screen.addstr(row, bx, "│", edge)
                    self.screen.addstr(row, bx + bw - 1, "│", edge)
                self.screen.addstr(bot, bx, "╰" + "─" * (bw - 2) + "╯"[:bw - 1], edge)
            except curses.error:
                pass
            if cur:
                if not self.filter:
                    self.ensure_detail(cur)
                self.draw_pane(cur, bx + 2, bw - 3, top + 1, bot - 1)

        # footer
        footer = (" ↑↓ move  enter cd  s shell  n new  e existing  d del  y sync"
                  "  / filter  t sort  space fold  tab pane  r refresh  q quit")
        self.screen.addstr(height - 2, 0, footer[:width - 1], curses.color_pair(1))
        if self.message:
            self.screen.addstr(height - 1, 0, self.message[:width - 1],
                               curses.color_pair(5))
        self.screen.refresh()

    def draw_pane(self, entry, x, w, y0, y1):
        if w < 12:
            return
        lines = self.detail_cache.get(entry.path)
        if lines is None:
            try:
                self.screen.addstr(y0, x, f" {entry.name} …",
                                   self.ATTR["dim"])
            except curses.error:
                pass
            return
        row = y0
        for style, text in lines:
            attr = self.ATTR.get(style, self.ATTR["norm"])
            if row > y1:
                try:
                    self.screen.addstr(y1, x, " … more", self.ATTR["dim"])
                except curses.error:
                    pass
                break
            for wrapped in textwrap.wrap(text, w - 2) or [""]:
                if row > y1:
                    break
                try:
                    self.screen.addstr(row, x, (" " + wrapped)[:w - 1], attr)
                except curses.error:
                    pass
                row += 1
            row += 1  # blank line between sections

    def loop(self):
        self.draw()
        while True:
            # non-blocking polls while detail jobs are in flight
            self.screen.timeout(250 if self.detail_jobs else -1)
            key = self.screen.getch()
            h, w = self.screen.getmaxyx()

            if key == curses.KEY_RESIZE:
                curses.resizeterm(h, w)
                self.draw()
                continue

            if self.reap_detail_jobs():
                self.draw()  # a detail pane finished computing
                if key == -1:
                    continue

            if key == -1:
                continue

            if key == curses.KEY_UP or key == ord("k"):
                self.cur = max(0, self.cur - 1)
            elif key == curses.KEY_DOWN or key == ord("j"):
                self.cur = min(len(self.rows) - 1, self.cur + 1)
            elif key == curses.KEY_PPAGE:
                self.cur = max(0, self.cur - (h - 5))
            elif key == curses.KEY_NPAGE:
                self.cur = min(len(self.rows) - 1, self.cur + (h - 5))
            elif key == curses.KEY_HOME or key == ord("g"):
                self.cur = 0
            elif key == curses.KEY_END or key == ord("G"):
                self.cur = len(self.rows) - 1
            elif key in (10, 13, curses.KEY_ENTER):  # enter
                e = self.current()
                if e:
                    # always exit and print the path: a child process cannot
                    # cd the parent shell, so the stui wrapper does it; use
                    # `s` to spawn a subshell in the worktree instead
                    return e.path
                continue
            elif key == ord("s"):
                e = self.current()
                if e and e.kind != "project":
                    self.spawn_shell(e.path)
            elif key == ord("n"):
                e = self.current()
                if not e:
                    continue
                name = self.prompt(f"new worktree in {e.project}: ")
                if name:
                    self.run_stol(["new", name], cwd=os.path.join(PROJECTS_DIR, e.project))
            elif key == ord("e"):
                e = self.current()
                if not e:
                    continue
                branch = self.prompt(f"existing branch in {e.project}: ")
                if branch:
                    self.run_stol(["new", "--existing", branch],
                                  cwd=os.path.join(PROJECTS_DIR, e.project))
            elif key == ord("d"):
                e = self.current()
                if e and e.kind != "project":
                    if self.confirm(f"delete worktree {e.project}/{e.name}?"):
                        self.run_stol(["rm", f"{e.project}/{e.name}"])
            elif key == ord("y"):
                e = self.current()
                if e:
                    self.run_stol(["sync", e.project])
            elif key == ord("t"):
                self.sort_time = not self.sort_time
                self.refresh_data()
                self.message = f"sorted by {'time' if self.sort_time else 'name'}"
            elif key == ord("/"):
                self.filter_prompt()
            elif key == ord("r"):
                self.refresh_data()
                self.message = "refreshed"
            elif key == 9 or key == ord("p"):  # tab toggles the pane
                self.show_pane = not self.show_pane
            elif key == ord(" ") and self.current() and self.current().kind == "project":
                name = self.current().name
                if name in self.collapsed:
                    self.collapsed.discard(name)
                else:
                    self.collapsed.add(name)
                self.rebuild_rows()
            elif key == ord("?"):
                self.show_help()
                self.draw()
            elif key in (ord("q"), 27):  # q or escape
                return None
            self.draw()

    def show_help(self):
        self.screen.erase()
        h, w = self.screen.getmaxyx()
        lines = __doc__.splitlines()
        self.screen.addstr(0, 0, " stol tui help", curses.color_pair(2) | curses.A_BOLD)
        for i, line in enumerate(lines[9:], start=1):  # skip module docstring preamble
            if i + 1 >= h:
                break
            try:
                self.screen.addstr(i + 1, 0, ("  " + line.strip())[:w - 1])
            except curses.error:
                pass
        self.screen.addstr(h - 2, 0, "press any key to return", curses.color_pair(7))
        self.screen.refresh()
        self.screen.getch()


def main():
    # ncurses waits ESCDELAY ms to disambiguate a lone Esc from escape
    # sequences; the 1s default makes Esc feel unresponsive
    os.environ.setdefault("ESCDELAY", "150")

    if not os.path.isdir(PROJECTS_DIR):
        print(f"stol tui: no such directory: {PROJECTS_DIR}", file=sys.stderr)
        print("set STOL_ROOT to your stol filesystem root", file=sys.stderr)
        return 1

    # When stdout is not a terminal (e.g. invoked as `cd "$(stol tui)"`), the
    # TUI must render on /dev/tty instead. Point fd 1 at the tty and remember
    # the original pipe so only the final path is written to stdout; without
    # this, curses output would be swallowed by the pipe and the screen would
    # appear frozen, and command output would pollute the captured result.
    result_fd = None
    if not sys.stdout.isatty():
        try:
            tty_fd = os.open("/dev/tty", os.O_RDWR)
        except OSError as e:
            print(f"stol tui: no controlling terminal: {e}", file=sys.stderr)
            return 1
        result_fd = os.dup(1)
        os.dup2(tty_fd, 1)
        os.close(tty_fd)
        sys.stdout.reconfigure(line_buffering=True)

    try:
        result = curses.wrapper(lambda scr: Tui(scr).loop())
    except KeyboardInterrupt:
        # Ctrl-C quits without changing directory (terminal is restored by
        # curses.wrapper's finally before we get here)
        result = None
    except curses.error as e:
        print(f"stol tui: terminal error: {e}", file=sys.stderr)
        result = None

    if result_fd is not None:
        if result:
            os.write(result_fd, (result + "\n").encode())
        os.close(result_fd)
    elif result:
        print(result)
    return 0


if __name__ == "__main__":
    sys.exit(main())
